# MAGADH TYRES Backend Microservice - Environment Configuration

# Server Port (Default: 5000 for standalone, 3000 in AI Studio dev environment)
PORT=5000
NODE_ENV=development

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=*

# Google Gemini AI API Configuration (For AI Tyre Advisor)
GEMINI_API_KEY=

# AWS Amplify / Cognito / AppSync Configuration (Optional for Cloud Integration)
AWS_REGION=ap-south-1
AWS_USER_POOL_ID=
AWS_USER_POOL_CLIENT_ID=
AWS_APPSYNC_GRAPHQL_ENDPOINT=
AWS_APPSYNC_API_KEY=
AWS_DYNAMODB_TABLE_PREFIX=magadh_tyres_
